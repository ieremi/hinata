{
  "compilerOptions": {
    "target": "ES2021",
    "lib": ["ES2021", "DOM"],
    "module": "esnext",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "forceConsistentCasingInFileNames": true,
    "removeComments": false,
    "newLine": "lf",
    "rootDir": "src",
    "outDir": "."
  },
  "include": ["src/hinata.user.ts"],
  "exclude": []
}
